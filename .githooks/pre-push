# Check every file version in the commits about to be pushed (scripts/check_commit.py), so
# commits made with --no-verify or by a history rewrite are checked too.
check="$(git rev-parse --show-toplevel)/scripts/check_commit.py"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # deleting a remote branch
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"           # a new branch: everything not already on a remote
    else
        range="$remote_sha..$local_sha"
    fi
    python3 "$check" --range "$range" || status=1
done
exit $status
